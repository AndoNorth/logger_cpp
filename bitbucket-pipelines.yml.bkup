image: atlassian/default-image:2
definitions:
  services:
    docker:
      memory: 3072
  steps:

    - step: &docker-tag
        name: Compute docker tag
        script:
          - echo "Compute docker tag (commit=$BITBUCKET_COMMIT)"
        artifacts:
          - docker.tag

    - step: &build
        name: Build
        services:
          - docker
        script:
          - export DOCKER_TAG_NAME=$(cat ./docker.tag)
          - export IMG_NAME=coroborsystems/$BITBUCKET_REPO_SLUG:${DOCKER_TAG_NAME}
          - docker login $DOCKER_REGISTRY_FQDN --username $DOCKER_REGISTRY_USERNAME --password $DOCKER_REGISTRY_TOKEN
          - docker build --file Dockerfile . --tag $IMG_NAME --build-arg GIT_TAG_REV=$BITBUCKET_COMMIT
          - docker push $IMG_NAME

    - step: &release
        name: Create release Version
        trigger: manual
        services:
          - docker
        script:
          - docker login $DOCKER_REGISTRY_FQDN --username $DOCKER_REGISTRY_USERNAME --password $DOCKER_REGISTRY_TOKEN
          - docker cp $(docker create coroborsystems/pipeline-scripts):/next-mss-version.py ./next-mss-version.py
          # MSS version is already incremented from previous release
          # just remove the CUSTOM_BUILD_tag if any
          - NEW_MSS_VERSION=`python next-mss-version.py Source/application_version.h --remove-custom-tag`
          - git add Source/application_version.h
          - git commit --message "Release $NEW_MSS_VERSION"
          # Tag then push
          - git tag --annotate --message "Create tag $NEW_MSS_VERSION" $NEW_MSS_VERSION
          - git remote set-url origin ${BITBUCKET_GIT_SSH_ORIGIN}
          - git push origin $NEW_MSS_VERSION
          # Increase to next version with custom tag to signal development version
          - python next-mss-version.py Source/application_version.h --increment-version
          - NEW_MSS_VERSION=`python next-mss-version.py Source/application_version.h --set-custom-tag DEV1`
          - git add Source/application_version.h
          - git commit --message "[skip ci] Incremented to next development version $NEW_MSS_VERSION"
          - git remote set-url origin ${BITBUCKET_GIT_SSH_ORIGIN}
          - git push origin
    - step: &increment-dev-version
        name: Increment DEV version
        services:
          - docker
        script:
          - docker login $DOCKER_REGISTRY_FQDN --username $DOCKER_REGISTRY_USERNAME --password $DOCKER_REGISTRY_TOKEN
          - docker cp $(docker create coroborsystems/pipeline-scripts):/next-mss-version.py ./next-mss-version.py
          - NEW_MSS_VERSION=`python next-mss-version.py application_version.h --increment-custom-tag`
          - git add application_version.h
          - git commit --message "[skip ci] Increment to next development version $NEW_MSS_VERSION"
          - git remote set-url origin ${BITBUCKET_GIT_SSH_ORIGIN}
          - git push origin
    - step: &release-notification
        name: Send notification ###### watch out indentation here when copy pasting YAML ! ######
        script:
          - docker login $DOCKER_REGISTRY_FQDN --username $DOCKER_REGISTRY_USERNAME --password $DOCKER_REGISTRY_TOKEN
          - pipe: docker://coroborsystems/pipeline-pipe-notification:v1.0.6
            variables:
              WEBHOOK_URL: '$TEAMS_WEBHOOK_URL_RELEASE'
              MESSAGE: '[RELEASE] $BITBUCKET_REPO_SLUG was released : $BITBUCKET_TAG'
          
pipelines:

  default:
    - step:
        <<: *docker-tag
        after-script:
          - echo $BITBUCKET_BRANCH > ./docker.tag
    - step: *build

  branches:
    master:
      - step:
          <<: *docker-tag
          after-script:
            - echo latest-10.0 > ./docker.tag
      - step: *build
      - step: *release

  tags:
    v10.0.*:
      - step:
          <<: *docker-tag
          after-script:
            - echo $BITBUCKET_TAG > ./docker.tag
      - step: *build
